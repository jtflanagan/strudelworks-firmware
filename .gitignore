# Fetched at a pinned SHA by third_party/fetch_uberddr3.sh, not vendored, so
# upstream's GPL-3.0-or-later code stays visibly upstream's.  See LICENSING.md.
/third_party/UberDDR3/

# Same treatment for Klaus Dormann's test suites (GPL-3.0), fetched by
# third_party/fetch_6502_tests.sh.
/third_party/6502_tests/

# Vivado
/build/work/
/build/vivado.log
/build/vivado.jou
*.jou
*.log
*.str
.Xil/
vivado_*.backup.jou
vivado_*.backup.log

__pycache__/
*.pyc

# out-of-context synthesis reports, regenerated by build/synth_ooc.sh
/build/ooc/

# simulation build products
/sim/*.out
/sim/cpu_work/
/sim/trace_work/
/sim/bustest_work/

# apple/build.sh output: the assembled exerciser and its disk image
/apple/build/

# The DOS 3.3 image apple/build.sh copies to make a bootable disk.  Apple's
# code, so it is referenced and never committed - same treatment as UberDDR3
# and Klaus Dormann's suites.  See LICENSING.md.
/apple/base/

# SingleStepTests/65816, fetched by sim/fetch_65816_tests.sh.  Not vendored:
# the suite states no licence, and the full set is 2.9 GB.
/sim/cpu816_work/
/sim/mem_work/
/sim/mmu_work/

/build/results/

# host-side build products
/tools/ft601/ft601_probe
/sim/accel_work/
/sim/boot_work/
/sim/fb_work/
/sim/vbeam_work/
/sim/cpu_predict_work/
/sim/tlb_work/

# sim/suite.sh: its logs, and the local list of boot images (paths differ per machine)
/sim/suite_work/
/sim/images.local

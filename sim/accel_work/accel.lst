000000r 1               ;
000000r 1               ; accel.s - sim/mem_integ.s with a $C100-$CFFF section, for sim/accel_tb.sv: exercises every kind of
000000r 1               ; memory the card's image claims to serve, and says whether each read came
000000r 1               ; back right.  Runs from RAM at $6000 (copied out of the ROM by the reset
000000r 1               ; code), with the auxiliary-memory and RamWorks tests in ROM because RAMRD
000000r 1               ; would take the code away from under them.
000000r 1               ;
000000r 1               ; PASS ($0300) counts completed passes; FAILF ($03FF) is $FF if anything
000000r 1               ; disagreed, and the program then halts.
000000r 1               
000000r 1               PASS    = $0300
000000r 1               FAILF   = $03FF
000000r 1               RWFLAG  = $03FE          ; non-zero once the card is serving: run the RamWorks test
000000r 1               PTR     = $06
000000r 1               
000000r 1               .macro  jne target
000000r 1                       beq :+
000000r 1                       jmp target
000000r 1               :
000000r 1               .endmacro
000000r 1               
000000r 1               .segment "CODE"
000000r 1               
000000r 1               main:
000000r 1  A9 00                lda #$00
000002r 1  8D 00 03             sta PASS
000005r 1  8D FF 03             sta FAILF
000008r 1               loop:
000008r 1                       ; ---- 1. a page of RAM, written and read back ----------------------------
000008r 1  A9 00                lda #$00
00000Ar 1  85 06                sta PTR
00000Cr 1  A9 10                lda #$10
00000Er 1  85 07                sta PTR+1
000010r 1  A0 00                ldy #0
000012r 1  98           fill:   tya
000013r 1  18                   clc
000014r 1  6D 00 03             adc PASS
000017r 1  91 06                sta (PTR),y
000019r 1  C8                   iny
00001Ar 1  D0 F6                bne fill
00001Cr 1  E6 07                inc PTR+1
00001Er 1  A5 07                lda PTR+1
000020r 1  C9 11                cmp #$11
000022r 1  D0 EE                bne fill
000024r 1  A9 10                lda #$10
000026r 1  85 07                sta PTR+1
000028r 1  A0 00                ldy #0
00002Ar 1  98           ver:    tya
00002Br 1  18                   clc
00002Cr 1  6D 00 03             adc PASS
00002Fr 1  D1 06                cmp (PTR),y
000031r 1  F0 03 4C rr          jne fail
000035r 1  rr           
000036r 1  C8                   iny
000037r 1  D0 F1                bne ver
000039r 1  E6 07                inc PTR+1
00003Br 1  A5 07                lda PTR+1
00003Dr 1  C9 11                cmp #$11
00003Fr 1  D0 E9                bne ver
000041r 1               
000041r 1                       ; ---- 2. the stack and a subroutine -----------------------------------
000041r 1  A9 5A                lda #$5A
000043r 1  48                   pha
000044r 1  20 rr rr             jsr sub
000047r 1  68                   pla
000048r 1  C9 5A                cmp #$5A
00004Ar 1  F0 03 4C rr          jne fail
00004Er 1  rr           
00004Fr 1               
00004Fr 1                       ; ---- 3. the language card --------------------------------------------
00004Fr 1  AD 83 C0             lda $C083               ; bank 2, read RAM, two reads: write enabled
000052r 1  AD 83 C0             lda $C083
000055r 1  A9 D2                lda #$D2
000057r 1  8D 00 D0             sta $D000
00005Ar 1  A9 E1                lda #$E1
00005Cr 1  8D 00 E0             sta $E000
00005Fr 1  AD 8B C0             lda $C08B               ; bank 1, read RAM, write enabled
000062r 1  AD 8B C0             lda $C08B
000065r 1  A9 D1                lda #$D1
000067r 1  8D 00 D0             sta $D000
00006Ar 1  AD 00 D0             lda $D000
00006Dr 1  C9 D1                cmp #$D1
00006Fr 1  F0 03 4C rr          jne fail
000073r 1  rr           
000074r 1  AD 00 E0             lda $E000               ; shared above $E000
000077r 1  C9 E1                cmp #$E1
000079r 1  F0 03 4C rr          jne fail
00007Dr 1  rr           
00007Er 1  AD 80 C0             lda $C080               ; bank 2, read RAM, write protected
000081r 1  AD 00 D0             lda $D000
000084r 1  C9 D2                cmp #$D2
000086r 1  F0 03 4C rr          jne fail
00008Ar 1  rr           
00008Br 1  A9 77                lda #$77
00008Dr 1  8D 00 D0             sta $D000               ; must land nowhere
000090r 1  AD 00 D0             lda $D000
000093r 1  C9 D2                cmp #$D2
000095r 1  F0 03 4C rr          jne fail
000099r 1  rr           
00009Ar 1  AD 82 C0             lda $C082               ; bank 2, read ROM, write protected
00009Dr 1  AD 00 D0             lda $D000
0000A0r 1  C9 C7                cmp #$C7                ; the ROM's byte there
0000A2r 1  F0 03 4C rr          jne fail
0000A6r 1  rr           
0000A7r 1  AD 81 C0             lda $C081               ; read ROM, write RAM bank 2
0000AAr 1  AD 81 C0             lda $C081
0000ADr 1  A9 D3                lda #$D3
0000AFr 1  8D 00 D0             sta $D000               ; lands under the ROM
0000B2r 1  AD 00 D0             lda $D000
0000B5r 1  C9 C7                cmp #$C7
0000B7r 1  F0 03 4C rr          jne fail
0000BBr 1  rr           
0000BCr 1  AD 80 C0             lda $C080
0000BFr 1  AD 00 D0             lda $D000
0000C2r 1  C9 D3                cmp #$D3
0000C4r 1  F0 03 4C rr          jne fail
0000C8r 1  rr           
0000C9r 1  AD 89 C0             lda $C089               ; one read of an odd address: no write enable yet
0000CCr 1  A9 44                lda #$44
0000CEr 1  8D 00 D0             sta $D000               ; bank 1: still write protected
0000D1r 1  AD 8B C0             lda $C08B
0000D4r 1  AD 00 D0             lda $D000
0000D7r 1  C9 D1                cmp #$D1
0000D9r 1  F0 03 4C rr          jne fail
0000DDr 1  rr           
0000DEr 1  AD 82 C0             lda $C082               ; back to ROM, protected, before touching aux
0000E1r 1               
0000E1r 1                       ; ---- 4. auxiliary memory, from the ROM -------------------------------
0000E1r 1  20 rr rr             jsr auxtest
0000E4r 1  B0 4D                bcs fail
0000E6r 1               
0000E6r 1                       ; ---- 5. the RamWorks banks, from the ROM - once the card is serving.
0000E6r 1                       ; The machine the testbench models has no RamWorks; the card is it,
0000E6r 1                       ; and only its image can answer.  The testbench sets RWFLAG through
0000E6r 1                       ; the override path when it turns serving on.
0000E6r 1  AD FE 03             lda RWFLAG
0000E9r 1  F0 05                beq norw
0000EBr 1  20 rr rr             jsr rwtest
0000EEr 1  B0 43                bcs fail
0000F0r 1               norw:
0000F0r 1  20 rr rr             jsr cxtest
0000F3r 1               
0000F3r 1  EE 00 03             inc PASS
0000F6r 1  4C rr rr             jmp loop
0000F9r 1               
0000F9r 1               ; ---- $C100-$CFFF: the internal ROM, a slot ROM, the expansion ROM latch ----
0000F9r 1               ; Reads whose bytes the testbench checks against its own model of UTAIIe
0000F9r 1               ; 5-28 (rtl/apple_mmu.sv, "THE CX CLASS"); the program only makes them.
0000F9r 1               ; Every switch is restored before returning.
0000F9r 1  8D 07 C0     cxtest: sta $C007               ; INTCXROM on: all of $C100-$CFFF is internal
0000FCr 1  AD 00 C1             lda $C100
0000FFr 1  AD FF C3             lda $C3FF
000102r 1  AD 00 C8             lda $C800
000105r 1  AD FE CF             lda $CFFE
000108r 1  AD FF CF             lda $CFFF
00010Br 1  8D 06 C0             sta $C006               ; off: the slots' pages are the slots'
00010Er 1  8D 0A C0             sta $C00A               ; SLOTC3ROM off: $C3xx is internal regardless
000111r 1  AD 00 C3             lda $C300               ; ...and sets INTC8ROM
000114r 1  AD 00 C8             lda $C800               ; internal, by that latch
000117r 1  AD FF CF             lda $CFFF               ; clears it
00011Ar 1  AD 00 C8             lda $C800               ; nothing there now: the floating bus
00011Dr 1  AD 00 C5             lda $C500               ; the testbench's slot 5 card ROM
000120r 1  AD 00 C4             lda $C400               ; an empty slot
000123r 1  8D 0B C0             sta $C00B               ; SLOTC3ROM on: slot 3's page is the slot's
000126r 1  AD 00 C3             lda $C300               ; ...which is empty
000129r 1  AD 00 C8             lda $C800               ; still nothing: no INTC8ROM without slot 3 internal
00012Cr 1  8D 0A C0             sta $C00A               ; restore
00012Fr 1  60                   rts
000130r 1               
000130r 1  A9 C3        sub:    lda #$C3
000132r 1  60                   rts
000133r 1               
000133r 1  A9 FF        fail:   lda #$FF
000135r 1  8D FF 03             sta FAILF
000138r 1  4C rr rr     halt:   jmp halt
00013Br 1               
00013Br 1               .import __CODE_LOAD__, __CODE_RUN__, __CODE_SIZE__
00013Br 1               
00013Br 1               .segment "BOOT"
000000r 1               
